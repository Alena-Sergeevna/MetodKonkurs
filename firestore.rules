rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Студент отправляет результат из десктоп-курса без логина.
    // Преподаватель читает после входа (Email/Password).
    match /students/{studentId} {
      allow create, update: if
        request.resource.data.keys().hasAll(['name', 'courseId', 'updatedAt'])
        && request.resource.data.courseId == 'rest-api-laravel'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /submissions/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'courseId', 'sentAt', 'studentKey'])
        && request.resource.data.courseId == 'rest-api-laravel'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120;
      allow read, update, delete: if request.auth != null;
    }
  }
}
